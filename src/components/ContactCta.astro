---
import DemoLink from './DemoLink.astro';
---

<section id="contacto" class="section contact">
  <div class="container">
    <div class="contact-card">
      <span class="contact-decoration" aria-hidden="true">
        n
      </span>
      <div class="contact-copy">
        <p class="eyebrow">EL PRIMER PASO ES CONOCER TU NEGOCIO</p>
        <h2>
          Tu marca crece.
          <br />
          Que el orden la acompañe.
        </h2>
        <p>
          Contanos cómo manejás tu stock y veamos juntos si NexoStock es la herramienta para tu
          próxima etapa.
        </p>
        <DemoLink placement="contact" secondary />
        <p class="contact-note">Demo de 15 minutos · Por videollamada · Sin compromiso</p>
      </div>
    </div>
  </div>
</section>
