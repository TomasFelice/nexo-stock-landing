---
import DemoLink from './DemoLink.astro';
import Icon from './Icon.astro';
import ProductPreview from './ProductPreview.astro';
---

<section id="hero" class="hero section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">
        <span></span> PARA MARCAS DE INDUMENTARIA CON TIENDANUBE
      </p>
      <h1>
        Tu stock del local y Tiendanube,
        <br />
        <em>bajo control.</em>
      </h1>
      <p class="hero-description">
        Sabé qué podés vender, dónde está cada talle y qué stock publicás online. Ordená tu
        operación con una puesta en marcha acompañada.
      </p>
      <div class="hero-actions">
        <DemoLink placement="hero" />
        <a class="text-link" href="#como-funciona" data-demo-open data-placement="hero">
          <span class="play-icon">
            <Icon name="play" size={15} />
          </span>
          Ver cómo funciona
        </a>
      </div>
      <p class="cta-note">Nos contás cómo trabajás. Te mostramos si NexoStock encaja.</p>
      <div class="hero-proof">
        <span>
          <Icon name="check" size={16} /> Stock por talle y color
        </span>
        <span>
          <Icon name="check" size={16} /> Implementación remota
        </span>
      </div>
    </div>
    <ProductPreview />
  </div>
  <div class="container">
    <div class="connection-strip">
      <span>DEL MOSTRADOR A TU TIENDA ONLINE</span>
      <div>
        <Icon name="store" size={18} />
        <strong>Tu local</strong>
        <span class="connector"></span>
        <img src="/nexo-stock-logo.webp" width="23" height="23" alt="" />
        <strong>NexoStock</strong>
        <span class="connector"></span>
        <strong>Tiendanube</strong>
      </div>
    </div>
  </div>
</section>
