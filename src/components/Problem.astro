---
import Icon from './Icon.astro';
const benefits = [
  {
    icon: 'shirt',
    before: '“Sé que está, pero no sé dónde.”',
    title: 'Cada talle y color, ubicado.',
    text: 'Consultá cantidades por variante y depósito. Registrá transferencias para acompañar el recorrido de la mercadería.',
  },
  {
    icon: 'shield',
    before: '“Ese stock no lo quiero vender online.”',
    title: 'Publicá con tus propias reglas.',
    text: 'Elegí qué depósitos suman a Tiendanube. Separá fallados y distinguí las unidades físicas de las que necesitás conseguir.',
  },
  {
    icon: 'swap',
    before: '“El cambio quedó anotado en un papel.”',
    title: 'Movimientos con historial.',
    text: 'Registrá ventas y cambios con su impacto en el stock. Consultá el historial para entender qué pasó con cada producto.',
  },
];
---

<section class="section benefits" aria-labelledby="benefits-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">PENSADO PARA EL DÍA A DÍA DE TU MARCA</p>
      <h2 id="benefits-title">
        El orden se nota
        <br />
        en cada operación.
      </h2>
    </div>
    <div class="benefit-grid">
      {benefits.map((item) => (
        <article class="benefit-card">
          <span class="benefit-icon">
            <Icon name={item.icon} size={27} />
          </span>
          <p class="before-quote">{item.before}</p>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
