<script>
    document.addEventListener("DOMContentLoaded", () => {
        const toggleBtn = document.getElementById("billing-toggle");
        const toggleCircle = document.getElementById("toggle-circle");
        const textMonthly = document.getElementById("text-monthly");
        const textAnnual = document.getElementById("text-annual");

        const btnUsd = document.getElementById("btn-usd");
        const btnArs = document.getElementById("btn-ars");

        const priceDisplays = document.querySelectorAll(".price-display");
        const billingNotes = document.querySelectorAll(".billing-note");
        const annualTotals = document.querySelectorAll(".annual-total");
        const currencyLabels = document.querySelectorAll(".currency-label");
        const annualCurrencies = document.querySelectorAll(".annual-currency");
        const setupFeePrice = document.getElementById("setup-fee-price");

        let isAnnual = false;
        let isArs = false;
        let exchangeRate = 1;
        const SETUP_FEE_USD = 30; // matched to user edit

        // Fetch Dolar Oficial
        fetch("https://dolarapi.com/v1/dolares/oficial")
            .then((response) => response.json())
            .then((data) => {
                if (data && data.venta) {
                    exchangeRate = data.venta;
                    // update if user toggled ARS before fetch complete
                    if (isArs) {
                        updateUI();
                    }
                }
            })
            .catch((error) =>
                console.error("Error fetching exchange rate:", error),
            );

        function formatPrice(usdPrice) {
            const num = isArs ? usdPrice * exchangeRate : usdPrice;
            return isArs
                ? new Intl.NumberFormat("es-AR", {
                      maximumFractionDigits: 0,
                  }).format(num)
                : num.toString();
        }

        function updateUI() {
            const currencyStr = isArs ? "ARS" : "USD";

            // Update plan prices
            priceDisplays.forEach((display) => {
                const usdPrice = isAnnual
                    ? parseFloat(display.getAttribute("data-annual"))
                    : parseFloat(display.getAttribute("data-monthly"));
                display.textContent = `$${formatPrice(usdPrice)}`;
            });

            // Update annual totals
            annualTotals.forEach((total) => {
                const usdPrice = parseFloat(total.getAttribute("data-usd"));
                total.textContent = `$${formatPrice(usdPrice)}`;
            });

            // Update currencies
            currencyLabels.forEach(
                (label) => (label.textContent = currencyStr),
            );
            annualCurrencies.forEach(
                (label) => (label.textContent = currencyStr),
            );

            // Update billing notes visibility
            billingNotes.forEach((note) => {
                if (isAnnual) note.classList.remove("hidden");
                else note.classList.add("hidden");
            });

            // Update Setup Fee
            if (isAnnual) {
                setupFeePrice.innerHTML = `<span class="line-through text-slate-400">$${formatPrice(SETUP_FEE_USD)} ${currencyStr}</span> <span class="text-brand ml-1">Gratis</span>`;
            } else {
                setupFeePrice.innerHTML = `Valor: $${formatPrice(SETUP_FEE_USD)} ${currencyStr}`;
            }

            // Update billing toggle styles
            if (isAnnual) {
                toggleBtn.setAttribute("aria-checked", "true");
                toggleBtn.classList.remove("bg-slate-200");
                toggleBtn.classList.add("bg-brand");
                toggleCircle.classList.remove("translate-x-0");
                toggleCircle.classList.add("translate-x-5");
                textMonthly.classList.remove("text-slate-dark");
                textMonthly.classList.add("text-slate");
                textAnnual.classList.remove("text-slate");
                textAnnual.classList.add("text-slate-dark");
            } else {
                toggleBtn.setAttribute("aria-checked", "false");
                toggleBtn.classList.remove("bg-brand");
                toggleBtn.classList.add("bg-slate-200");
                toggleCircle.classList.remove("translate-x-5");
                toggleCircle.classList.add("translate-x-0");
                textMonthly.classList.remove("text-slate");
                textMonthly.classList.add("text-slate-dark");
                textAnnual.classList.remove("text-slate-dark");
                textAnnual.classList.add("text-slate");
            }

            // Update currency toggle styles
            if (isArs) {
                btnArs.classList.add(
                    "bg-white",
                    "shadow-sm",
                    "text-slate-dark",
                    "font-bold",
                );
                btnArs.classList.remove(
                    "text-slate",
                    "hover:text-slate-dark",
                    "font-medium",
                );

                btnUsd.classList.remove(
                    "bg-white",
                    "shadow-sm",
                    "text-slate-dark",
                    "font-bold",
                );
                btnUsd.classList.add(
                    "text-slate",
                    "hover:text-slate-dark",
                    "font-medium",
                );
            } else {
                btnUsd.classList.add(
                    "bg-white",
                    "shadow-sm",
                    "text-slate-dark",
                    "font-bold",
                );
                btnUsd.classList.remove(
                    "text-slate",
                    "hover:text-slate-dark",
                    "font-medium",
                );

                btnArs.classList.remove(
                    "bg-white",
                    "shadow-sm",
                    "text-slate-dark",
                    "font-bold",
                );
                btnArs.classList.add(
                    "text-slate",
                    "hover:text-slate-dark",
                    "font-medium",
                );
            }
        }

        if (toggleBtn) {
            toggleBtn.addEventListener("click", () => {
                isAnnual = !isAnnual;
                updateUI();
            });
        }

        if (btnUsd && btnArs) {
            btnUsd.addEventListener("click", () => {
                if (isArs) {
                    isArs = false;
                    updateUI();
                }
            });
            btnArs.addEventListener("click", () => {
                if (!isArs) {
                    isArs = true;
                    updateUI();
                }
            });
        }
    });
</script>
