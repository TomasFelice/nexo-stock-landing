                        role="switch"
                        aria-checked="false"
                    >
                        <span
                            aria-hidden="true"
                            class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out translate-x-0"
                            id="toggle-circle"></span>
                    </button>
                    <div class="flex items-center gap-2">
                        <span
                            class="text-sm font-medium text-slate-dark"
                            id="text-annual">Anual</span
