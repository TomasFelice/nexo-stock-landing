---
import DemoLink from './DemoLink.astro';
import Icon from './Icon.astro';
import { offer } from '../lib/site';
import fallbackQuote from '../data/exchange-rate.json';
import { loadQuote, formatArs, formatQuoteDate } from '../lib/exchange-rate.mjs';
const { quote } = await loadQuote({ fallback: fallbackQuote });
const includes = [
  'Una tienda Tiendanube conectada',
  `Hasta ${offer.physicalLocations} ubicaciones físicas`,
  'Depósitos de fallados y virtual',
  'Stock por variante, talle y color',
  'Registro de ventas, cambios y transferencias',
  'Reportes e historial de movimientos',
  'Soporte de uso en horario comercial',
];
---

<section id="pricing" class="section pricing" aria-labelledby="pricing-title">
  <div class="container pricing-grid">
    <div class="section-heading">
      <p class="eyebrow">UNA OFERTA CLARA PARA EMPEZAR</p>
      <h2 id="pricing-title">
        Ordená tu stock.
        <br />
        <span>Conocé tu inversión.</span>
      </h2>
      <p>
        Un plan para marcas que venden en un local y en Tiendanube. Si tu operación necesita otro
        alcance, lo conversamos en la demo.
      </p>
      <div class="pricing-side-note">
        <Icon name="chat" size={23} />
        <p>
          Primero vemos si encaja.
          <br />
          <strong>La demo no tiene costo ni compromiso.</strong>
        </p>
      </div>
    </div>
    <div
      class="price-card"
      data-peso-pricing
      data-monthly-usd={offer.monthly}
      data-setup-usd={offer.setup}
      data-initial-quote={JSON.stringify(quote)}
    >
      <div class="price-card-top">
        <span class="plan-name">Plan Negocio</span>
        <span class="launch-label">PRECIO DE LANZAMIENTO</span>
      </div>
      <div class="price-line">
        <span class="price-currency" data-price-currency>
          {quote ? '$' : 'USD'}
        </span>
        <strong data-monthly-amount>
          {quote ? formatArs(offer.monthly, quote.venta) : offer.monthly}
        </strong>
        <span class="price-period">
          <span data-price-unit>{quote ? 'ARS' : ''}</span> / mes
        </span>
      </div>
      <p class="price-reference" data-price-reference>
        {quote
          ? `Estimado en pesos · referencia USD ${offer.monthly}/mes`
          : 'Se cobra en pesos. Consultanos el equivalente actualizado.'}
      </p>
      <p class="price-subtitle">Gestión de stock + conexión con Tiendanube</p>
      <ul class="included-list">
        {includes.map((item) => (
          <li>
            <Icon name="check" size={17} />
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <div class="setup-fee">
        <div>
          <strong>Implementación remota</strong>
          <span>Pago único</span>
        </div>
        <div class="setup-price">
          <strong data-setup-amount>
            {quote ? `$${formatArs(offer.setup, quote.venta)} ARS` : `USD ${offer.setup}`}
          </strong>
          <span>Referencia USD {offer.setup}</span>
        </div>
      </div>
      <p class="setup-description">
        Incluye una importación inicial sobre tu planilla y una capacitación remota de hasta una
        hora.
      </p>
      <div class="exchange-note" aria-live="polite" aria-atomic="true">
        <p data-exchange-status>
          {quote
            ? `Dólar oficial vendedor: $${formatArs(1, quote.venta)} · cotización del ${formatQuoteDate(quote.fechaActualizacion)}.`
            : 'El equivalente en pesos no está disponible por el momento.'}
        </p>
        <p>
          Fuente:{' '}
          <a
            href="https://dolarapi.com/docs/argentina/operations/get-dolar-oficial"
            target="_blank"
            rel="noopener noreferrer"
          >
            DolarAPI / Ámbito
          </a>
          . Importe orientativo.
        </p>
      </div>
      <DemoLink placement="pricing" class="price-cta" />
      <p class="price-terms">
        El importe final se calcula en pesos al dólar oficial vendedor del Banco Nación al emitir
        cada cobro; puede variar respecto de este estimado. La cotización detalla el importe final y
        los impuestos que correspondan.
      </p>
      <p class="price-terms">
        Desarrollos, limpieza extensa de datos y nuevas integraciones se cotizan por separado.
        Suscripción de Tiendanube no incluida.
      </p>
    </div>
  </div>
</section>

<script>
  import {
    loadQuote,
    validateQuote,
    formatArs,
    formatQuoteDate,
    RATE_CACHE_KEY,
    CACHE_TTL_MS,
  } from '../lib/exchange-rate.mjs';
  const root = document.querySelector<HTMLElement>('[data-peso-pricing]');
  if (root) {
    const monthly = Number(root.dataset.monthlyUsd);
    const setup = Number(root.dataset.setupUsd);
    let initial: unknown = null;
    try {
      initial = JSON.parse(root.dataset.initialQuote || 'null');
    } catch {
      /* No fabricated rate. */
    }
    let current = validateQuote(initial);
    let cached: { fetchedAt: number; quote: unknown } | null = null;
    try {
      const value = JSON.parse(localStorage.getItem(RATE_CACHE_KEY) || 'null');
      if (
        value &&
        typeof value.fetchedAt === 'number' &&
        value.fetchedAt <= Date.now() &&
        validateQuote(value.quote)
      )
        cached = value;
    } catch {
      /* Storage is optional. */
    }
    const cachedQuote = validateQuote(cached?.quote);
    if (
      cachedQuote &&
      (!current ||
        Date.parse(cachedQuote.fechaActualizacion) > Date.parse(current.fechaActualizacion))
    )
      current = cachedQuote;
    const setText = (selector: string, value: string) => {
      const element = root.querySelector(selector);
      if (element) element.textContent = value;
    };
    const render = (quote: ReturnType<typeof validateQuote>, offline = false) => {
      root.classList.toggle('price-unavailable', !quote);
      setText('[data-price-currency]', quote ? '$' : 'USD');
      setText('[data-price-unit]', quote ? 'ARS' : '');
      setText('[data-monthly-amount]', quote ? formatArs(monthly, quote.venta) : String(monthly));
      setText(
        '[data-price-reference]',
        quote
          ? `Estimado en pesos · referencia USD ${monthly}/mes`
          : 'Se cobra en pesos. Consultanos el equivalente actualizado.',
      );
      setText(
        '[data-setup-amount]',
        quote ? `$${formatArs(setup, quote.venta)} ARS` : `USD ${setup}`,
      );
      setText(
        '[data-exchange-status]',
        quote
          ? `Dólar oficial vendedor: $${formatArs(1, quote.venta)} · cotización del ${formatQuoteDate(quote.fechaActualizacion)}.${offline ? ' Último valor disponible; no pudimos actualizarlo ahora.' : ''}`
          : 'No pudimos obtener una cotización reciente. Consultanos el importe en pesos.',
      );
    };
    render(current);
    if (!cached || Date.now() - cached.fetchedAt >= CACHE_TTL_MS || !current) {
      loadQuote({ fallback: current }).then(({ quote, live }) => {
        render(quote, !live);
        if (live && quote) {
          try {
            localStorage.setItem(RATE_CACHE_KEY, JSON.stringify({ fetchedAt: Date.now(), quote }));
          } catch {
            /* No persistence required. */
          }
        }
      });
    }
  }
</script>
