---
import { whatsappUrl } from '../lib/site';
const home = Astro.url.pathname === '/' ? '' : '/';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a class="brand" href="/" aria-label="NexoStock, inicio">
        <img src="/nexo-stock-logo.webp" width="34" height="34" alt="" />
        <span>
          <strong>nexo</strong>stock<small>by Benai</small>
        </span>
      </a>
      <p>
        El stock de tu marca,
        <br />
        en su lugar.
      </p>
      <nav aria-label="Enlaces del pie">
        <a href={`${home}#como-funciona`}>Cómo funciona</a>
        <a href={`${home}#pricing`}>Precio y alcance</a>
        <a
          href={whatsappUrl}
          data-whatsapp
          data-placement="footer"
          target="_blank"
          rel="noopener noreferrer"
        >
          Contactar por WhatsApp
        </a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} NexoStock. Un producto de Benai.</span>
      <div>
        <a href="/privacidad">Privacidad</a>
        <a href="/condiciones">Condiciones</a>
        <button type="button" data-privacy-settings>
          Preferencias de medición
        </button>
      </div>
    </div>
  </div>
</footer>
